INSERT INTO TEXTS VALUES('Canopus Decree','Stele','Premier des grands decrets sacerdotaux, en trois langues, pris a loccasion dune grande reunion de pretres (tous les 5 ans).Stele Caire (CG 22187) trouvee a Tanis en 1866. Texte dans Sethe, Urk. II, p.124-154. (Il existe 5 exemplaires connus de ce meme decret). Traduction: Romain','Ideographic Indicator','','','','Sethe','UrkII p124','http://library.case.edu/ksl/ecoll/books/sethie01/sethie01.pdf','0')
